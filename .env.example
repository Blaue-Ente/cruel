# ArgosScout environment variables

SCRAPER_API_KEY=

# LLM: auto | openrouter | openai | anthropic | groq | nvidia | huggingface | ollama | rule
LLM_PROVIDER=auto

# OpenRouter — one key for Claude 3.5/3.7, DeepSeek, Llama, Mistral, Gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL_LIGHT=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_REASONING=anthropic/claude-3.5-sonnet

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o

# Anthropic native Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LIGHT=claude-3-5-haiku-latest
ANTHROPIC_MODEL_REASONING=claude-3-5-sonnet-latest

# Groq — fastest free tier (console.groq.com) — preferred for light tasks
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# NVIDIA NIM (build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Hugging Face (fallback)
HF_TOKEN=
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Ollama — local free SLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Admin: leave ADMIN_SECRET empty to auto-generate data/.admin_secret (chmod 600).
# The shipped default "cruel-admin-change-me" is rejected.
ADMIN_SECRET=
ALLOW_INSECURE_DEFAULTS=false

# Optional public-registry keys (search-URL fallback works without them)
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=
GITHUB_TOKEN=

APEX_MAX_STEPS=8
APEX_MAX_SOURCES=6

# Vision scraping
VISION_ENABLED=true
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Predictive pre-scraping
PREDICTIVE_ENABLED=true
PREDICTIVE_INTERVAL_SEC=300
PREDICTIVE_MAX_TOPICS=3

# Pheromones — Redis primary, SQLite fallback
REDIS_URL=redis://localhost:6379/0
PHEROMONE_BACKEND=auto

# IMAP inbox — real email responses from conversational probes
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
INBOX_ENABLED=false
INBOX_POLL_INTERVAL_SEC=120

# StockArgos ecosystem webhook
STOCKARGOS_WEBHOOK_URL=
STOCKARGOS_WEBHOOK_SECRET=

# Privacy Layers — ghost | standard | eu_shield | de_fortress | hunter
DEFAULT_PRIVACY_LAYER=standard
COMPLIANCE_COUNTRY=DE

# Outbound fetch + rate limits
SSRF_ALLOW_PRIVATE=false
RATE_LIMIT_ANONYMOUS=30
RATE_LIMIT_AUTHENTICATED=120
RATE_LIMIT_WINDOW_SEC=60

# High-risk options are OFF until the operator reads the in-app notice,
# checks authorized use, types "I ACCEPT THE RISK" or "ПРИЕМАМ РИСКА",
# then enables each switch in Settings. Do not set these to skip that gate.
# FLARESOLVERR_URL=http://127.0.0.1:8191
# FLARESOLVERR_TIMEOUT_MS=45000
# FLARESOLVERR_ALLOW_REMOTE=false
# CURL_CFFI_IMPERSONATE=chrome
# Optional TLS impersonation extra: pip install curl_cffi

# Dual-layer research. Security/privacy/SSRF always on; verification is optional.
# RESEARCH_LAYERS_ENABLED=true
# RESEARCH_LOCAL_ONLY=false
# RESEARCH_CLOUD_FALLBACK=false

APP_HOST=0.0.0.0
APP_PORT=8000
